{
  "name": "tts-tools",
  "displayName": "TTS Tools (Community Fork)",
  "author": {
    "name": "Eunomiac (fork); based on work by Sebastian Stern"
  },
  "publisher": "eunomiac",
  "description": "Community fork of Sebastian Stern’s TTS Editor — External Editor API for Tabletop Simulator (scripts, XmlUI bundling, objects). Not affiliated with Berserk Games.",
  "version": "2.7.0",
  "engines": {
    "vscode": "^1.96.0"
  },
  "homepage": "https://github.com/Eunomiac/tts-tools/tree/main/packages/tts-editor",
  "repository": {
    "type": "git",
    "url": "https://github.com/Eunomiac/tts-tools",
    "directory": "packages/tts-editor"
  },
  "bugs": {
    "url": "https://github.com/Eunomiac/tts-tools/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:lua",
    "workspaceContains:**/*.lua",
    "workspaceContains:**/*.ttslua"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ttsEditor.getObjects",
        "title": "Get Objects",
        "category": "TTS Editor",
        "icon": "$(git-fetch)"
      },
      {
        "command": "ttsEditor.saveAndPlay",
        "title": "Save and Play",
        "category": "TTS Editor",
        "icon": "$(send)"
      },
      {
        "command": "ttsEditor.saveAndPlayBundled",
        "title": "Save and Play (Bundled)",
        "category": "TTS Editor",
        "icon": "$(send)"
      },
      {
        "command": "ttsEditor.saveAndPlayFullResync",
        "title": "Save and Play (Full Resync)",
        "category": "TTS Editor",
        "icon": "$(sync)"
      },
      {
        "command": "ttsEditor.saveAndPlayBundledFullResync",
        "title": "Save and Play Bundled (Full Resync)",
        "category": "TTS Editor",
        "icon": "$(sync)"
      },
      {
        "command": "ttsEditor.claimEditorPort",
        "title": "Claim TTS Editor Port",
        "category": "TTS Editor",
        "icon": "$(plug)"
      },
      {
        "command": "ttsEditor.releaseEditorPort",
        "title": "Release TTS Editor Port",
        "category": "TTS Editor",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "ttsEditor.executeCode",
        "title": "Execute Code",
        "category": "TTS Editor",
        "icon": "$(run)"
      },
      {
        "command": "ttsEditor.showOutput",
        "title": "Show Output",
        "category": "TTS Editor"
      },
      {
        "command": "ttsEditor.goToLastError",
        "title": "Go to Last Error",
        "category": "TTS Editor"
      },
      {
        "command": "ttsEditor.getRuntimeUi",
        "title": "Get Runtime UI",
        "category": "TTS Editor",
        "icon": "$(window)"
      },
      {
        "command": "ttsEditor.getObjectState",
        "title": "Get Object State",
        "category": "TTS Editor",
        "icon": "$(file-binary)"
      },
      {
        "command": "ttsEditor.updateObjectState",
        "title": "Update Object State",
        "category": "TTS Editor",
        "icon": "$(link-external)",
        "enablement": "resourceFilename =~ /\\.state\\.txt$/"
      },
      {
        "command": "ttsEditor.updateObject",
        "title": "Update Object",
        "category": "TTS Editor"
      },
      {
        "command": "ttsEditor.getObject",
        "title": "Get Object",
        "category": "TTS Editor",
        "icon": "$(git-fetch)"
      },
      {
        "command": "ttsEditor.locateObject",
        "title": "Locate Object",
        "category": "TTS Editor",
        "icon": "$(location)"
      },
      {
        "command": "ttsEditor.openBundledScript",
        "title": "Open Bundled Script",
        "category": "TTS Editor",
        "icon": "$(go-to-file)"
      },
      {
        "command": "ttsEditor.createUi",
        "title": "Create UI",
        "category": "TTS Editor"
      },
      {
        "command": "ttsEditor.unbundleLibrary",
        "title": "Unbundle Library",
        "category": "TTS Editor"
      }
    ],
    "keybindings": [
      {
        "command": "ttsEditor.getObjects",
        "key": "ctrl+alt+l"
      },
      {
        "command": "ttsEditor.saveAndPlay",
        "key": "ctrl+alt+s"
      },
      {
        "command": "ttsEditor.executeCode",
        "key": "ctrl+shift+e",
        "when": "editorFocus"
      }
    ],
    "configuration": [
      {
        "id": "ttsEditor.general",
        "title": "TTS Editor",
        "order": 1,
        "properties": {
          "ttsEditor.includePath": {
            "markdownDescription": "Relative path inside the workspace directory that is used to resolve modules.",
            "type": "string",
            "default": ".",
            "order": 1
          },
          "ttsEditor.enableMessages": {
            "markdownDescription": "When set, custom messages sent from TTS are handled. Otherwise, they are ignored.",
            "type": "boolean",
            "default": true,
            "order": 2
          },
          "ttsEditor.sync.mode": {
            "markdownDescription": "How object files are refreshed when a game loads in TTS.",
            "type": "string",
            "enum": [
              "fast",
              "classic"
            ],
            "enumDescriptions": [
              "Write scripts and UI from the load message. Ask TTS for an object's full data only when there is no `data.json` for it yet. Much faster on large saves.",
              "Ask TTS for every object's full data on every load, including after Save and Play (the original extension's behavior). Always fresh `data.json`, slow on large saves."
            ],
            "default": "fast",
            "order": 3
          },
          "ttsEditor.resyncAfterSaveAndPlay": {
            "markdownDescription": "With **Sync: Mode** set to `fast`, also rebuild every object's `data.json` after each Save and Play (slow on large saves). The **Save and Play (Full Resync)** commands do this for a single Save and Play.",
            "type": "boolean",
            "default": false,
            "order": 4
          },
          "ttsEditor.sync.cleanUpOnLoad": {
            "markdownDescription": "Which files under `.tts` are deleted when a game loads.",
            "type": "string",
            "enum": [
              "removedObjects",
              "everything",
              "nothing"
            ],
            "enumDescriptions": [
              "Delete files for objects that are not in the loaded game (removed objects, renamed objects, or a different mod). Files for objects still in the game are kept and updated.",
              "Delete all of `.tts/objects`, `.tts/bundled` and `.tts/output`, then rebuild them (the original extension's behavior).",
              "Never delete anything. Files from other mods or removed objects stay on disk."
            ],
            "default": "removedObjects",
            "order": 5
          },
          "ttsEditor.updateObject.source": {
            "markdownDescription": "Where **Update Object** takes everything except the script, UI and state from before it respawns the object.",
            "type": "string",
            "enum": [
              "liveTable",
              "dataFile"
            ],
            "enumDescriptions": [
              "Read the object from the running game first, so its position, contents and other changes made in TTS are kept.",
              "Use the object's `data.json` file (the original extension's behavior). Choose this if you edit `data.json` by hand."
            ],
            "default": "liveTable",
            "order": 6
          },
          "ttsEditor.sync.preserveGlobalStubs": {
            "markdownDescription": "Keep a hand-written `objects/Global.lua` that only contains `require(...)` lines, or an `objects/Global.xml` that only contains `<Include src=...>` tags, instead of replacing it with the copy from TTS on load. Save and Play always rebundles these stubs from their include files, even with **Save and Play (Bundled)**.",
            "type": "boolean",
            "default": false,
            "order": 7
          }
        }
      },
      {
        "id": "ttsEditor.connection",
        "title": "Connection and AI Agents",
        "order": 2,
        "properties": {
          "ttsEditor.connection.mode": {
            "markdownDescription": "How the extension connects to Tabletop Simulator. TTS only talks to one program on port 39998, so sharing needs a small helper process.",
            "type": "string",
            "enum": [
              "gateway",
              "direct"
            ],
            "enumDescriptions": [
              "Start a small helper process that holds the TTS port and shares it with other local tools (such as the MCP server below). Falls back to `direct` if the helper cannot start.",
              "The extension listens on the TTS port itself, like the original extension. Other local tools cannot connect at the same time."
            ],
            "default": "gateway",
            "order": 1
          },
          "ttsEditor.mcp.enabled": {
            "markdownDescription": "Offer a built-in MCP server named `tts-tools` to AI agents in Cursor and VS Code, so they can run Lua in TTS and read its output. Needs **Connection: Mode** set to `gateway`.",
            "type": "boolean",
            "default": true,
            "order": 2
          }
        }
      },
      {
        "id": "ttsEditor.compatibility",
        "title": "Compatibility",
        "order": 3,
        "properties": {
          "ttsEditor.compatibility.behaveLikeOriginal": {
            "markdownDescription": "Behave like the original TTS Editor extension this fork is based on, while keeping its bug fixes. Overrides these settings while enabled: **Connection: Mode** → `direct`, **Sync: Mode** → `classic`, **Sync: Clean Up On Load** → `everything`, **Update Object: Source** → `dataFile`, **Sync: Preserve Global Stubs** → off, **MCP: Enabled** → off.",
            "type": "boolean",
            "default": false,
            "order": 1
          }
        }
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "ttsEditor.mcpServer",
        "label": "TTS Tools (Tabletop Simulator)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "ttsEditor.objectView",
          "name": "TTS Objects"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ttsEditor.objectView",
        "contents": "No objects have been loaded yet\n[Load objects](command:ttsEditor.getObjects)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ttsEditor.getObjects",
          "when": "view == ttsEditor.objectView",
          "group": "navigation"
        },
        {
          "command": "ttsEditor.saveAndPlay",
          "when": "view == ttsEditor.objectView"
        },
        {
          "command": "ttsEditor.saveAndPlayBundled",
          "when": "view == ttsEditor.objectView"
        },
        {
          "command": "ttsEditor.saveAndPlayFullResync",
          "when": "view == ttsEditor.objectView"
        },
        {
          "command": "ttsEditor.claimEditorPort",
          "when": "view == ttsEditor.objectView"
        },
        {
          "command": "ttsEditor.releaseEditorPort",
          "when": "view == ttsEditor.objectView"
        },
        {
          "command": "ttsEditor.showOutput",
          "when": "view == ttsEditor.objectView"
        }
      ],
      "view/item/context": [
        {
          "command": "ttsEditor.getRuntimeUi",
          "when": "view == ttsEditor.objectView && (viewItem =~ /^object/ || viewItem =~ /^global/)",
          "group": "inline@1"
        },
        {
          "command": "ttsEditor.getObjectState",
          "when": "view == ttsEditor.objectView && (viewItem =~ /^object/ || viewItem =~ /^global/)",
          "group": "inline@2"
        },
        {
          "command": "ttsEditor.getObject",
          "when": "view == ttsEditor.objectView && viewItem =~ /^object/"
        },
        {
          "command": "ttsEditor.updateObject",
          "when": "view == ttsEditor.objectView && viewItem =~ /^object/"
        },
        {
          "command": "ttsEditor.createUi",
          "when": "view == ttsEditor.objectView && (viewItem =~ /^object/ || viewItem =~ /^global/) && !(viewItem =~ /\\.ui/)"
        },
        {
          "command": "ttsEditor.locateObject",
          "when": "view == ttsEditor.objectView && viewItem =~ /^object/"
        },
        {
          "command": "ttsEditor.openBundledScript",
          "when": "view == ttsEditor.objectView && viewItem == script",
          "group": "inline"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "ttsEditor.walkthrough",
        "title": "Get Started with TTS Editor",
        "description": "Get an overview of the most essential features",
        "steps": [
          {
            "id": "startTts",
            "title": "Start TTS",
            "description": "Startup Tabletop Simulator.",
            "media": {
              "markdown": "media/tour/startTts.md"
            },
            "completionEvents": [
              "onContext:ttsEditor.ttsRunning"
            ]
          },
          {
            "id": "openWorkspace",
            "title": "Open a workspace folder",
            "description": "First open a folder or workspace in VS Code.",
            "media": {
              "markdown": "media/tour/openWorkspace.md"
            },
            "completionEvents": [
              "onContext:workbenchState != empty"
            ]
          },
          {
            "id": "getObjects",
            "title": "Get objects",
            "description": "Get the objects from TTS to work with them. \n[Get Objects](command:ttsEditor.getObjects)",
            "media": {
              "markdown": "media/tour/getObjects.md"
            },
            "completionEvents": [
              "onCommand:ttsEditor.getObjects"
            ]
          },
          {
            "id": "openView",
            "title": "Open Object View",
            "description": "Open the object explorer in the explorer activity bar.\n[Show View](command:ttsEditor.showView)",
            "media": {
              "markdown": "media/tour/openView.md"
            },
            "completionEvents": [
              "onView:ttsEditor.objectView"
            ]
          },
          {
            "id": "saveAndPlay",
            "title": "Edit, Save & Play",
            "description": "Edit some scripts. Then send the adjusted scripts back to TTS via Save & Play.\n[Save and Play](command:ttsEditor.saveAndPlay)",
            "media": {
              "markdown": "media/tour/saveAndPlay.md"
            },
            "completionEvents": [
              "onView:ttsEditor.objectView"
            ]
          },
          {
            "id": "openOutput",
            "title": "Open the console output",
            "description": "Want to see the print and log messages TTS sends? Open the TTS output channel.\n[Show Output](command:ttsEditor.showOutput)",
            "media": {
              "markdown": "media/tour/openOutput.md"
            },
            "completionEvents": [
              "onCommand:ttsEditor.showOutput"
            ]
          },
          {
            "id": "moreFeatures",
            "title": "More Features",
            "description": "More features await!",
            "media": {
              "markdown": "media/tour/more.md"
            }
          }
        ]
      }
    ]
  },
  "icon": "media/icon.png",
  "scripts": {
    "vscode:package": "node -e \"require('fs').mkdirSync(require('path').join(__dirname,'../../dist'),{recursive:true})\" && vsce package -o ../../dist/tts-tools.vsix",
    "vscode:prepublish": "npm run compile && npm run copy-gateway",
    "compile": "tsc -p ./",
    "copy-gateway": "node ./scripts/copy-gateway.js",
    "smoke:mcp": "node ./scripts/smoke-mcp.js",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "dependencies": {
    "@tts-tools/gateway-client": "file:../gateway-client",
    "@tts-tools/savefile": "file:../savefile",
    "@tts-tools/xmlbundle": "file:../xmlbundle",
    "luabundle": "^1.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@typed-tabletop-simulator/declaration": "^2.2.1",
    "@types/node": "^22.16.5",
    "@types/vscode": "^1.96.0",
    "@typescript-to-lua/language-extensions": "^1.19.0",
    "@vscode/test-electron": "^2.3.4",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^9.35.0",
    "glob": "^11.0.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  }
}
